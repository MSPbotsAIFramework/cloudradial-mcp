# Optional overrides — cloudradial-mcp has no required env vars.
# Authentication is per-request via HTTP headers:
#   X-CloudRadial-Public-Key  (required — Public Key / username for HTTP Basic Auth)
#   X-CloudRadial-Private-Key (required — Private Key / password for HTTP Basic Auth)
# Generate these under Partner > Settings > Integrations > API in the CloudRadial portal.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# CLOUDRADIAL_BASE_URL=https://api.us.cloudradial.com
